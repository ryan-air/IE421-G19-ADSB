# ADS-B Streamer Configuration
# Copy this file to .env and fill in your values

# Supabase Database Connection
# Use the Session Pooler connection string (port 5432 or 6543)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: Override receiver ID (defaults to hostname)
# RECEIVER_ID=my-custom-receiver-id

# Optional: dump1090 connection (defaults shown)
# DUMP1090_HOST=localhost
# DUMP1090_PORT=30003
