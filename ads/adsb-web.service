[Unit]
Description=ADS-B Web Application Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=jdoe
Group=jdoe
WorkingDirectory=/home/jdoe/adsb-receiver/group_19_project/ads

# Load environment variables from .env file (for DATABASE_URL)
EnvironmentFile=/home/jdoe/adsb-receiver/group_19_project/ads/.env

# Set Node environment to production
Environment="NODE_ENV=production"

# Run the Node.js server
ExecStart=/usr/bin/node /home/jdoe/adsb-receiver/group_19_project/ads/server.js

# Restart on failure
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adsb-web

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
