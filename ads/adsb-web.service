[Unit]
Description=ADS-B Web Application Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/adsb-web

# Load environment variables from .env file (for DATABASE_URL)
EnvironmentFile=/home/pi/adsb-web/.env

# Set Node environment to production
Environment="NODE_ENV=production"

# Run the Node.js server
ExecStart=/usr/bin/node /home/pi/adsb-web/server.js

# Restart on failure
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adsb-web

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
